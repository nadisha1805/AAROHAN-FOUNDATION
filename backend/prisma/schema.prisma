generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Cause {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String
  image       String?
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  campaigns   Campaign[]
}

model Campaign {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String
  image       String?
  goalAmount  Decimal  @db.Decimal(12, 2)
  raisedAmount Decimal @db.Decimal(12, 2)
  causeId     String?
  cause       Cause?    @relation(fields: [causeId], references: [id])
  startDate   DateTime?
  endDate     DateTime?
  status      String   @default("active")
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model VolunteerApplication {
  id          String   @id @default(cuid())
  fullName    String
  email       String
  phone       String
  city        String
  interests   String
  skills      String
  availability String
  message     String?
  status      String   @default("new")
  createdAt   DateTime @default(now())
}

model ContactEnquiry {
  id        String   @id @default(cuid())
  fullName  String
  email     String
  phone     String?
  subject   String
  message   String
  status    String   @default("new")
  createdAt DateTime @default(now())
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  status    String   @default("active")
  createdAt DateTime @default(now())
}

model Story {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  description String
  content     String
  image       String?
  publishedAt DateTime?
  status      String    @default("draft")
  createdAt   DateTime  @default(now())
}

model EventItem {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  description String
  image       String?
  location    String
  startDate   DateTime
  endDate     DateTime?
  status      String    @default("upcoming")
  createdAt   DateTime  @default(now())
}

model ImpactUpdate {
  id          String   @id @default(cuid())
  title       String
  description String
  image       String?
  metricValue String?
  metricLabel String?
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
}
